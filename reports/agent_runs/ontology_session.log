# Онтология проекта — шаблон. Скопируйте в корень проекта как ontology.yaml и замените <…>.
# Образец заполнения — demo_graph/ontology.yaml. Проверка: python3 check_week4.py

ontology: <короткое имя проекта>
goal: >
  <Одна-две фразы: на какие вопросы должен отвечать граф проекта и кто им пользуется —
  исследователь, агент, рецензент.>

# Компетентностные вопросы: 3–5. Каждый класс и каждое отношение нужны хотя бы одному.
competency_questions:
  - <Вопрос 1 на естественном языке>
  - <Вопрос 2>
  - <Вопрос 3>

# Классы — множества объектов. Имя — существительное в единственном числе, без пробелов.
# parent — надкласс (null для верхних классов); definition — признак, по которому объект
# попадает в класс. Экземпляры (конкретная серия, конкретная статья) сюда не пишутся.
classes:
  <ВерхнийКласс>:
    parent: null
    definition: <признак>
  <КлассА>:
    parent: <ВерхнийКласс>
    definition: <признак>
  <КлассБ>:
    parent: <ВерхнийКласс>
    definition: <признак>
  Задача:
    parent: null
    definition: поручение пользователя или его часть; заметки задач в tasks/ ведёт агент
  Файл:
    parent: null
    definition: файл проекта — таблица, код, текст; узел графа — сам файл

# Отношения: domain — класс источника связи, range — класс цели (можно список).
# characteristics — по желанию: [транзитивное], [функциональное], [симметричное].
properties:
  <отношение>: {domain: <КлассА>, range: <КлассБ>}
  хранитсяВ: {domain: <КлассА>, range: Файл}        # связь объекта с файлом проекта
  подзадачаОт: {domain: Задача, range: Задача, characteristics: [транзитивное]}

# Атрибуты — поле в начале заметки со значением из списка, например status: выполнена.
attributes:
  status: {domain: Задача, values: [открыта, в работе, выполнена, заблокирована, принята]}

# Правила: не меньше двух. text — словами, dl — в дескрипционной логике.
# check — по желанию: как проверять правило на графе (закрытый мир). Виды:
#   some                 C ⊑ ∃R.D      — у каждого C есть связь R с D
#   some_inverse         C ⊑ ∃R⁻.D     — у каждого C есть входящая связь R от D
#   some_inverse_any     C ⊑ ∃R1⁻.⊤ ⊔ ∃R2⁻.⊤ — у каждого C есть входящая связь R1 или R2
#   all_inverse          C ⊑ ∀R⁻.D     — все, кто связан с C связью R, принадлежат D
#   defined              E ≡ C ⊓ ∃R.D  — скрипт выведет экземпляры класса E
#   defined_inverse      E ≡ C ⊓ (∃R1⁻.⊤ ⊔ ∃R2⁻.⊤) — скрипт выведет экземпляры E
#   defined_value        E ≡ C ⊓ ∃a.{v1, v2} — экземпляры C со значением атрибута a из списка
#   section              в заметке каждого C есть раздел «## <название>» (оформление)
#   disjoint_properties  связи R1 и R2 не соединяют одну и ту же пару
# В class, target и source можно указывать и определяемые классы (name из defined*).
rules:
  - id: П1
    text: <Каждый … связан с …>
    dl: "<КлассА> ⊑ ∃<отношение>.<КлассБ>"
    check: {kind: some, class: <КлассА>, property: <отношение>, target: <КлассБ>}
  - id: П2
    text: <…>
    dl: "<…>"# Онтология учебного исследования: классы, отношения, правила.
# Источник истины для графа проекта. По ней агент создаёт заметки классов в ontology/
# и проверяет связи заметок (AGENTS.md, раздел 2). Формат — practice.md.

ontology: учебное-исследование
goal: >
  Записывать ход исследования так, чтобы по графу проекта можно было ответить:
  какие задачи поставлены, из каких подзадач состоят, в каком они статусе и чем закрыты, на каких данных и каким методом получен
  результат, чем он проверен, какие ограничения действуют, где лежат файлы и на какие
  источники опирается отчёт.

competency_questions:
  - Какие задачи поставлены, из каких подзадач они состоят, в каком статусе и чем закрыты?
  - Какие результаты прошли независимую проверку?
  - На какие наборы данных с известными ограничениями опираются результаты?
  - В каком файле лежит каждый набор данных, код и результат?
  - На какие источники ссылается отчёт и какие результаты он описывает?

classes:
  ИнформационныйОбъект:
    parent: null
    definition: объект, который несёт сведения — задача, утверждение, данные, метод, текст
  Процесс:
    parent: null
    definition: то, что происходит во времени — опыт, расчёт, проверка
  Файл:
    parent: null
    definition: файл проекта — таблица, код, текст, источник; узел графа — сам файл, заметка о нём не нужна
  Задача:
    parent: ИнформационныйОбъект
    definition: поручение пользователя или его часть; заметки задач в tasks/ ведёт агент
  Утверждение:
    parent: ИнформационныйОбъект
    definition: высказывание, которое может оказаться истинным или ложным
  Гипотеза:
    parent: Утверждение
    definition: утверждение, которое проверяют в эксперименте
  Результат:
    parent: Утверждение
    definition: утверждение, полученное в эксперименте, с числом и условиями
  НаборДанных:
    parent: ИнформационныйОбъект
    definition: таблица или серия измерений
  Метод:
    parent: ИнформационныйОбъект
    definition: способ обработки данных или постановки опыта
  Источник:
    parent: ИнформационныйОбъект
    definition: опубликованная работа, на которую ссылаются; текст — в library/
  Ограничение:
    parent: ИнформационныйОбъект
    definition: известный дефект данных или условие применимости
  Отчёт:
    parent: ИнформационныйОбъект
    definition: текст об исследовании для читателя; заметка отчёта — сам файл в reports/
  Эксперимент:
    parent: Процесс
    definition: опыт или расчёт, который проверяет гипотезу
  Проверка:
    parent: Процесс
    definition: независимая проверка результата другим способом

properties:
  подзадачаОт:   {domain: Задача, range: Задача, characteristics: [транзитивное]}
  решает:        {domain: [Эксперимент, Проверка], range: Задача}
  выполняет:     {domain: Отчёт, range: Задача}
  проверяет:     {domain: Эксперимент, range: Гипотеза}
  использует:    {domain: Эксперимент, range: НаборДанных}
  применяет:     {domain: Эксперимент, range: Метод}
  даёт:          {domain: Эксперимент, range: Результат}
  подтверждает:  {domain: Результат, range: Гипотеза}
  опровергает:   {domain: Результат, range: Гипотеза}
  проверенЧерез: {domain: Результат, range: Проверка}
  ограничивает:  {domain: Ограничение, range: [НаборДанных, Результат]}
  входитВ:       {domain: НаборДанных, range: НаборДанных, characteristics: [транзитивное]}
  основанаНа:    {domain: [Гипотеза, Метод], range: Источник}
  описывает:     {domain: Отчёт, range: [Эксперимент, Результат]}
  ссылаетсяНа:   {domain: Отчёт, range: Источник}
  хранитсяВ:     {domain: [НаборДанных, Результат, Источник], range: Файл}
  реализованВ:   {domain: [Эксперимент, Проверка], range: Файл}

# Атрибуты — свойства со значением из списка (в заметке — поле в начале файла).
attributes:
  status:
    domain: Задача
    values: [открыта, в работе, выполнена, заблокирована, принята]

rules:
  - id: П1
    text: Каждый эксперимент проверяет хотя бы одну гипотезу.
    dl: "Эксперимент ⊑ ∃проверяет.Гипотеза"
    check: {kind: some, class: Эксперимент, property: проверяет, target: Гипотеза}
  - id: П2
    text: Каждый результат получен в каком-то эксперименте.
    dl: "Результат ⊑ ∃даёт⁻.Эксперимент"
    check: {kind: some_inverse, class: Результат, property: даёт, source: Эксперимент}
  - id: П3
    text: Принятый результат — результат, прошедший хотя бы одну проверку.
    dl: "ПринятыйРезультат ≡ Результат ⊓ ∃проверенЧерез.Проверка"
    check: {kind: defined, name: ПринятыйРезультат, class: Результат, property: проверенЧерез, target: Проверка}
  - id: П4
    text: Результат не может одновременно подтверждать и опровергать одну гипотезу.
    dl: "DisjointObjectProperties(подтверждает опровергает)"
    check: {kind: disjoint_properties, properties: [подтверждает, опровергает]}
  - id: П5
    text: Каждый набор данных указывает на файл, в котором лежит.
    dl: "НаборДанных ⊑ ∃хранитсяВ.Файл"
    check: {kind: some, class: НаборДанных, property: хранитсяВ, target: Файл}
  - id: П6
    text: Каждый отчёт ссылается хотя бы на один источник.
    dl: "Отчёт ⊑ ∃ссылаетсяНа.Источник"
    check: {kind: some, class: Отчёт, property: ссылаетсяНа, target: Источник}
  - id: П7
    text: Выполненная задача — задача со статусом «выполнена» или «принята».
    dl: "ВыполненнаяЗадача ≡ Задача ⊓ ∃status.{выполнена, принята}"
    check: {kind: defined_value, name: ВыполненнаяЗадача, class: Задача, attribute: status, values: [выполнена, принята]}
  - id: П8
    text: Выполненную задачу закрывает эксперимент, проверка или отчёт либо у неё есть подзадачи.
    dl: "ВыполненнаяЗадача ⊑ ∃решает⁻.⊤ ⊔ ∃выполняет⁻.⊤ ⊔ ∃подзадачаОт⁻.⊤"
    check: {kind: some_inverse_any, class: ВыполненнаяЗадача, properties: [решает, выполняет, подзадачаОт]}
  - id: П9
    text: Задача выполнена, только если выполнены все её подзадачи.
    dl: "ВыполненнаяЗадача ⊑ ∀подзадачаОт⁻.ВыполненнаяЗадача"
    check: {kind: all_inverse, class: ВыполненнаяЗадача, property: подзадачаОт, source: ВыполненнаяЗадача}
  - id: П10
    text: В заметке выполненной задачи есть раздел «Итог» — что сделано и чем проверено.
    dl: "— (правило оформления, проверяется по тексту заметки)"
    check: {kind: section, class: ВыполненнаяЗадача, section: Итог}# AGENTS.md — филогения Taraxacum по пластомам и ITS

## 0. Цель и образ результата

Проект изучает родственные связи видов Taraxacum. Мы сравниваем дерево по
полным пластомам с деревом по ITS и связываем обе топологии с метаданными
образцов, с их географией и со структурой пластома (длины LSC, SSC, IR).
Деревья уже построены в IQ-TREE. Работа агента — визуализация и
сопоставление, а не новый анализ.

В конце работы в проекте существуют:
- `results/viz/plastome_tree.pdf` — дерево пластомов с поддержками узлов
  (SH-aLRT/UFBoot);
- `results/viz/its_tree_metadata.pdf` — дерево ITS, листья окрашены по
  метаданным;
- `results/viz/tanglegram.pdf` — соответствие листьев двух деревьев;
- `results/geo/coordinates_found.csv` — координаты образцов с источником
  каждой точки; `results/viz/samples_map.pdf` — карта образцов;
- `results/viz/plastome_tree_lsc_ssc_ir.pdf` — длины LSC/SSC/IR рядом с
  деревом пластомов, образцы с отклонениями отмечены;
- скрипт каждого рисунка в `scripts/` и запись о каждом прогоне в `diary.md`.

Ничего больше создавать не надо. Каждый пункт — отдельная задача в `tasks/`
(раздел 8), задачи выполняются по порядку списка.

Учебная задача курса (ДЗ 1): статистика трёх FASTA, результат —
`results/hw1/fasta_stats.csv`. Задача в `tasks/`.

## 1. Критерий готовности

Задача выполнена, когда выполнено её «Готово, когда» в `tasks/` и пройдена
проверка. Вызови проверку сам перед окончательным ответом.

- Статистика FASTA: `python3 checks/check_hw1_fasta.py` возвращает 0.
- Рисунок дерева: число и имена листьев на рисунке совпадают с
  `.treefile`; каждый лист сопоставлен строке метаданных или внесён в
  список несопоставленных в «Итоге» задачи.
- Карта: у каждой точки есть источник в `coordinates_found.csv`; точки без
  источника на карте отсутствуют.
- LSC/SSC/IR: значения на рисунке совпадают с `ir_boundaries.csv` для трёх
  образцов, названных в «Итоге».

«Выглядит правильно» критерием не является: рисунок смотрит исследователь.

## 2. Карта проекта и источники

Где что лежит — в `INDEX.md`. Прочитай его первым.
- Дерево пластомов: `results/plastome_20261015/tree/plastome_ml.treefile`,
  поддержки — `node_supports.csv` рядом.
- Дерево ITS: `results/its_20261015/ITS2/ML.treefile`
  (вариант по полному ITS — `results/its_20261015/ITSfull/`).
- Метаданные: `taraxacum_metadata_corrected.csv`.
- Границы LSC/SSC/IR: `results/plastome_20261015/ir_boundaries.csv`.
- Геномы: `tarax/fasta_tarax/genomes/`. Статья: `memory/L2.md`.

В ветке ДЗ 1 есть только три FASTA, статья и граф; данных деревьев там нет.

### Чего агент не может знать сам

- Основные деревья — из `results/*_20261015/`. Деревья в `tarax/` — старые
  прогоны, их не использовать.
- В метаданных нет столбцов секции и плоидности: окраска — по `Sp_name` и
  `Location`. Секцию не выводить из названия вида.
- Координаты есть у 59 образцов из 72. Остальные искать только по номеру
  образца (accession, voucher) в GenBank, BOLD, GBIF; не нашлось — пусто.
- Пластомы кольцевые: разные старт, ориентация SSC и запись IR не являются
  структурной вариацией, пока последовательности не приведены к одному виду.
- Видовая идентификация образцов не подтверждена; пропуск в метаданных не
  означает отсутствия признака.
- Какое дерево основное и как трактовать конфликт пластом/ITS, решает
  исследователь.
- В кратком отчёте ДЗ 1 порядок образцов: NC_032056.1, KU361241.1, KU736960.1.

## 3. Инструменты и границы

- Python 3: pandas, matplotlib, Biopython. R: ape, ggtree, phytools,
  ggplot2, sf, rnaturalearth. Новые пакеты не устанавливать.
- Команды запускаются из корня проекта: `python3 scripts/<имя>.py`,
  `Rscript scripts/<имя>.R`.
- IQ-TREE и MAFFT не запускать: деревья готовы.
- Сеть — только для поиска координат и литературы (раздел 9).

